# Puerto del servidor
PORT=5000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:admin@localhost:5432/gestor_finanzas?schema=public"

# JWT Secret
JWT_SECRET=tu_clave_secreta_muy_segura_cambiala_en_produccion

# Entorno
NODE_ENV=development

# Origen permitido en producción (CORS)
CORS_ORIGIN=http://localhost:5173

# Cron de recurrentes (cada hora por defecto). false = desactivar
CRON_RECURRENTES=true
CRON_RECURRENTES_SCHEDULE=0 * * * *
# Secret para POST /api/sistema/recurrentes/ejecutar-interno (header X-Cron-Secret)
CRON_SECRET=cambia_este_secret_de_cron

# Rate limits
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300

# Configuración de logs
LOG_LEVEL=info
