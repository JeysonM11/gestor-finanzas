# Puerto del servidor
PORT=5000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:admin@localhost:5432/gestor_finanzas?schema=public"

# JWT / sesiones (v1.4)
JWT_SECRET=tu_clave_secreta_muy_segura_cambiala_en_produccion
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=gf_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# Entorno
NODE_ENV=development

# Origen permitido en producción (CORS) — credentials: true
CORS_ORIGIN=http://localhost:5173

# Cron de recurrentes (cada hora por defecto). false = desactivar
CRON_RECURRENTES=true
CRON_RECURRENTES_SCHEDULE=0 * * * *
# Cron de recordatorios (minuto 5 de cada hora). false = desactivar
CRON_RECORDATORIOS=true
CRON_RECORDATORIOS_SCHEDULE=5 * * * *
# Secret para POST .../ejecutar-interno (header X-Cron-Secret)
CRON_SECRET=cambia_este_secret_de_cron

# Rate limits
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
# Generaciones del Asesor IA por usuario/hora
ASESOR_RATE_LIMIT_MAX=10

# Asesor IA (v1.3) — sin GEMINI_API_KEY el asesor usa fallback sin IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=20000

# Configuración de logs
LOG_LEVEL=info
