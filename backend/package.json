{
  "name": "gestor-finanzas",
  "version": "1.4.0",
  "main": "app.js",
  "scripts": {
    "start": "prisma migrate deploy && node app.js",
    "dev": "nodemon app.js",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest -c jest.integration.config.js",
    "test:all": "jest",
    "test:watch": "jest --watch --testPathIgnorePatterns=integration",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=integration",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js"
  },
  "keywords": [
    "finanzas",
    "backend",
    "api",
    "nodejs",
    "express",
    "prisma",
    "jwt",
    "postgresql"
  ],
  "author": "Jeyson Miranda",
  "license": "ISC",
  "description": "Backend para aplicación de gestión de finanzas personales con Node.js, Express y Prisma ORM",
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-cron": "^4.6.0",
    "prisma": "^6.6.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^30.1.3",
    "nodemon": "^3.0.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "middlewares/**/*.js",
      "services/**/*.js",
      "utils/**/*.js",
      "validators/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 12,
        "branches": 5,
        "functions": 8,
        "lines": 12
      },
      "./utils/date.js": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      },
      "./utils/saldo.js": {
        "statements": 70,
        "branches": 65,
        "functions": 85,
        "lines": 70
      },
      "./utils/transaccion-filtros.js": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    },
    "verbose": true
  }
}
